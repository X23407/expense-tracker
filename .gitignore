# ============================================================================
# Git Ignore for Personal Expense Tracker (Python / Streamlit / SQLite)
# ============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite Databases & runtime storage
# Live user database is created automatically at runtime
*.db
*.sqlite
*.sqlite3
*.db-journal

# Streamlit secrets & local overrides (never commit API keys/credentials)
.streamlit/secrets.toml

# Environment variables & secrets
.env
.env.*
*.env

# Testing & Type Checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
coverage.xml

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Logs & temporary files
*.log
*.tmp
*.bak
tmp/
temp/

# User exported transaction backups
expenses_backup_*.csv

